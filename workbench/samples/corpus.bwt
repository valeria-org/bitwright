{"rule":0,"name":"core.bitwise::and_not_self","id":"a7155cc265a14fe9cc6247305f489835","kind":"rule","proven":true,"doc":"Complement.","examples":[["p & ~p","0:8"]],"source":"rule and_not_self<W>(x: W) { x & ~x => 0 }","ledger":"rule exhaustive(inst=6,maxw=6,cases=126,fired=126) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":1,"name":"core.arith::mul_pow2","id":"6496ccdcfe6d1bf9444d7f829bb87e6a","kind":"rule","proven":true,"doc":"Multiplying by a power of two is a shift.","examples":[["p * 8","p << 3"]],"source":"rule mul_pow2<W>(x: W, c: const W) { x * c => x << k if is_pow2(c) let k: W = ctz(c) }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=642) sampled(inst=22,cases=1408,fired=891)"}
{"rule":2,"name":"core.shift_canonical::shl_mask_dead","id":"b687f5007019479c0957cd7cf5afab11","kind":"rule","proven":true,"doc":"A mask that keeps every bit the shift keeps.","examples":[["(p & 63) << 2","p << 2"]],"source":"rule shl_mask_dead<W>(x: W, c: const W, k: const W) {\n        (x & c) << k => x << k if (c | ~(ones >>u k)) == ones\n    }","ledger":"rule exhaustive(inst=5,maxw=5,cases=37448,fired=32378) sampled(inst=22,cases=1408,fired=1104)"}
{"rule":3,"name":"core.arith::add_xor_and","id":"91a74de0aba7b7ddb91240edcadabeb2","kind":"identity","proven":true,"doc":"Xor plus twice the and is plus. (Twice is written as the shift `mul_pow2` makes of it:\npatterns are written in normal form, or bottom-up rewriting never reaches them.)","examples":[["(p ^ q) + ((p & q) << 1)","p + q"]],"source":"identity add_xor_and<W>(x: W, y: W) { (x ^ y) + ((x & y) << 1) <=> x + y }","ledger":"identity exhaustive(inst=6,maxw=6,cases=5460,fired=5460) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":4,"name":"core.arith::add_disjoint","id":"c21668d593d2958761d618170fb36e1a","kind":"rule","proven":true,"doc":"An add without carries is an or.","examples":[["(p & 0xf0) + (q & 15)","(p & 0xf0) | (q & 15)"]],"source":"rule add_disjoint<W>(x: W, y: W) { x + y => x | y if disjoint(x, y) }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=1092) sampled(inst=22,cases=1408,fired=991)"}
{"rule":5,"name":"core.arith::sub_and","id":"f494f97854ab0848902d5d10e05d614e","kind":"rule","proven":true,"doc":"Removing the common bits.","examples":[["p - (p & q)","p & ~q"]],"source":"rule sub_and<W>(x: W, y: W) { x - (x & y) => x & ~y }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=5460) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":6,"name":"core.arith::sub_or","id":"98af6cc381e96fdd11156579398556cb","kind":"rule","proven":true,"doc":"The bits an or adds.","examples":[["(p | q) - p","q & ~p"]],"source":"rule sub_or<W>(x: W, y: W) { (x | y) - x => y & ~x }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=5460) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":7,"name":"core.recovery_arith::xor_from_or_minus_and","id":"da70d981bf49c9fd64529be76dc44a95","kind":"rule","proven":true,"examples":[["(p | q) - (p & q)","p ^ q"]],"source":"rule xor_from_or_minus_and<W>(x: W, y: W) { (x | y) - (x & y) => x ^ y }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=5460) sampled(inst=22,cases=1408,fired=1408)"}
