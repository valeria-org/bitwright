{"rule":0,"name":"core.arith::add_disjoint","id":"c21668d593d2958761d618170fb36e1a","kind":"rule","proven":true,"doc":"An add without carries is an or.","examples":[["(p & 0xf0) + (q & 15)","(p & 0xf0) | (q & 15)"]],"source":"rule add_disjoint<W>(x: W, y: W) { x + y => x | y if disjoint(x, y) }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=1092) sampled(inst=22,cases=1408,fired=991)"}
{"rule":1,"name":"core.recovery_canonical::xor_sign_bit_add","id":"f18d342b0c28847a665ac1f8629c0834","kind":"rule","proven":true,"examples":[["(p ^ 128) + 128","p"]],"source":"rule xor_sign_bit_add<W>(x: W) { (x ^ bit(W - 1)) + bit(W - 1) => x }","ledger":"rule exhaustive(inst=6,maxw=6,cases=126,fired=126) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":2,"name":"core.guarded_recovery::increment_boolean","id":"cb487c5a0ad51813425d4989d024e1dd","kind":"rule","proven":true,"examples":[["p:1 + 1:1","~p:1"]],"source":"rule increment_boolean(x: 1) { x + 1 => ~x }","ledger":"rule exhaustive(inst=1,maxw=1,cases=2,fired=2,complete) sampled(inst=1,cases=64,fired=64)"}
{"rule":3,"name":"core.shift_canonical::xor_double_const","id":"f8b7cd67abbe4487834a05877680d74c","kind":"rule","proven":true,"examples":[["(p + p) ^ 6","(p ^ 3) << 1"]],"source":"rule xor_double_const<W>(x: W, m: const W) {\n        (x + x) ^ m => (x ^ c) << 1 if (m & 1) == 0 && one_use(x + x) let c: W = m >>u 1\n    }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=2730) sampled(inst=22,cases=1408,fired=685)"}
