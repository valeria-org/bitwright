{"rule":0,"name":"core.bitwise::and_mask_redundant","id":"4b04f26d37d4b772c21cf6f7c3c3c8dd","kind":"rule","proven":true,"doc":"A mask that keeps every bit the value may have set.","examples":[["(q & 15) & 0x3f","q & 15"]],"source":"rule and_mask_redundant<W>(x: W, c: const W) { x & c => x if zero_bits(x, ~c) }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=1092) sampled(inst=22,cases=1408,fired=926)"}
{"rule":1,"name":"core.bitwise::and_mask_disjoint","id":"724ff9a4b679b662432c8d23dcd9fb85","kind":"rule","proven":true,"doc":"A mask that keeps none of the bits the value may have set.","examples":[["(q & 0xf0) & 15","0:8"]],"source":"rule and_mask_disjoint<W>(x: W, c: const W) { x & c => 0 if zero_bits(x, c) }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=1092) sampled(inst=22,cases=1408,fired=982)"}
{"rule":2,"name":"core.shift_canonical::shl_mask_dead","id":"b687f5007019479c0957cd7cf5afab11","kind":"rule","proven":true,"doc":"A mask that keeps every bit the shift keeps.","examples":[["(p & 63) << 2","p << 2"]],"source":"rule shl_mask_dead<W>(x: W, c: const W, k: const W) {\n        (x & c) << k => x << k if (c | ~(ones >>u k)) == ones\n    }","ledger":"rule exhaustive(inst=5,maxw=5,cases=37448,fired=32378) sampled(inst=22,cases=1408,fired=1104)"}
{"rule":3,"name":"core.bitwise::or_absorb_and","id":"0575f368bd8b21ed6f428408bf9277b9","kind":"rule","proven":true,"doc":"Absorption.","examples":[["(q & p) | p","p"]],"source":"rule or_absorb_and<W>(x: W, y: W) { x | (x & y) => x }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=5460) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":4,"name":"core.guarded_recovery::recombine_shifted_field_or","id":"8f9b6c7b8382124830bab5f753252d29","kind":"rule","proven":true,"examples":[["(p & 15) | (((p >>u 4) + q) << 4)","p + (q << 4)"]],"source":"rule recombine_shifted_field_or<W>(x: W, a: W, m: const W, k: const W) {\n        (x & m) | (((x >>u k) + a) << k) => (x & keep) + (a << k)\n        if (k <=u W) && (m & (ones << k)) == 0\n        let keep: W = (ones << k) | m\n    }","ledger":"rule exhaustive(inst=4,maxw=4,cases=69904,fired=9020) sampled(inst=22,cases=1408,fired=75)"}
{"rule":5,"name":"core.guarded_recovery::split_mask_or_or","id":"3ebe1198631e1087ddabb16a6b70547c","kind":"rule","proven":true,"examples":[["(p & 240) | ((p & 2) | 1)","(p & 242) | 1"]],"source":"rule split_mask_or_or<W>(x: W, c: W, m: const W, n: const W) {\n        (x & m) | ((x & n) | c) => (x & k) | c let k: W = m | n\n    }","ledger":"rule exhaustive(inst=4,maxw=4,cases=69904,fired=69904) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":6,"name":"core.guarded_recovery_shuffle::recombine_extracted_field","id":"b550746379b99aa58a2c5bb6c72922e1","kind":"rule","proven":true,"examples":[["concat(trunc<4>(zext<8>(extract<4,3>(p)) + q), trunc<4>(p))","(p & 127) + (q << 4)"]],"source":"rule recombine_extracted_field<N, K, M>(x: N + K, a: N + K) where M <= N, N + K <= 512 {\n        concat(trunc<N>(zext<N + K>(extract<K, M>(x)) + a), trunc<K>(x))\n        => (x & lowmask(K + M)) + (a << K)\n    }","ledger":"rule exhaustive(inst=76,maxw=8,cases=1728208,fired=1728208) sampled(inst=357,cases=22848,fired=22848)"}
{"rule":7,"name":"core.guarded_recovery_shuffle::recombine_extracted_field_or","id":"3ce7db0c3329567af085c8376f7ddb39","kind":"rule","proven":true,"examples":[["concat(trunc<4>(zext<8>(extract<4,3>(p)) | q), trunc<4>(p))","(p & 127) | (q << 4)"]],"source":"rule recombine_extracted_field_or<N, K, M>(x: N + K, a: N + K) where M <= N, N + K <= 512 {\n        concat(trunc<N>(zext<N + K>(extract<K, M>(x)) | a), trunc<K>(x))\n        => (x & lowmask(K + M)) | (a << K)\n    }","ledger":"rule exhaustive(inst=76,maxw=8,cases=1728208,fired=1728208) sampled(inst=362,cases=23168,fired=23168)"}
{"rule":8,"name":"core.concat::concat_assoc","id":"0494da654abf31f834943b492cac0041","kind":"rule","proven":true,"doc":"Concatenation associates; right nesting is the canonical one.","examples":[["concat(concat(p, q), r)","concat(p, concat(q, r))"]],"source":"rule concat_assoc<A, B, C>(x: A, y: B, z: C) { concat(concat(x, y), z) => concat(x, concat(y, z)) }","ledger":"rule exhaustive(inst=212,maxw=16,cases=1345016,fired=1345016) sampled(inst=371,cases=23744,fired=23744)"}
