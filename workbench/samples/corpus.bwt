{"rule":0,"name":"core.sign::xor_lshr_signs","id":"4593d16a8aafa26bda98589a0df02814","kind":"rule","proven":true,"doc":"The xor of two sign bits shifted down is the sign bit of the xor.","examples":[["(p >>u 7) ^ (q >>u 7)","(p ^ q) >>u 7"]],"source":"rule xor_lshr_signs<W>(x: W, y: W) {\n        (x >>u (W - 1)) ^ (y >>u (W - 1)) => (x ^ y) >>u (W - 1)\n    }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=5460) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":1,"name":"core.select_idioms::select_by_xor_mask","id":"b6c8a35d5bde660c11f792433caf20d7","kind":"rule","proven":true,"doc":"Choosing by a mask with xor: `y ^ ((x ^ y) & m)`.","examples":[["q ^ ((p ^ q) & sext<8>(r:1))","select(r:1, p, q)"]],"source":"rule select_by_xor_mask<W>(c: 1, x: W, y: W) where 1 < W {\n        ((x ^ y) & sext<W>(c)) ^ y => select(c, x, y)\n    }","ledger":"rule exhaustive(inst=5,maxw=6,cases=10912,fired=10912) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":2,"name":"core.sign::slt_from_flags_word","id":"b2d108eb76f2ddf5509b3eab7551bd01","kind":"rule","proven":true,"doc":"SF != OF as a 0 or 1 word.","examples":[["(p - q ^ ((p - q ^ p) & (p ^ q))) >>u 7","zext<8>(p <s q)"]],"source":"rule slt_from_flags_word<W>(a: W, b: W) where 1 < W {\n        ((a - b) ^ (((a - b) ^ a) & (a ^ b))) >>u (W - 1) => zext<W>(a <s b)\n    }","ledger":"rule exhaustive(inst=5,maxw=6,cases=5456,fired=5456) sampled(inst=22,cases=1408,fired=1408)"}
{"rule":3,"name":"core.sign_tests::zext_negative","id":"2e17d7a859df4dfa4d8de2fb605a7f00","kind":"rule","proven":true,"doc":"The sign bit of `x` as a word: `x >>u (W - 1)`.","examples":[["zext<8>(p <s 0)","p >>u 7"]],"source":"rule zext_negative<W>(x: W) where 1 < W { zext<W>(x <s 0) => x >>u (W - 1) }","ledger":"rule exhaustive(inst=5,maxw=6,cases=124,fired=124) sampled(inst=22,cases=1408,fired=1408)"}
