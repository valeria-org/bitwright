{"rule":0,"name":"core.arith::udiv_pow2","id":"ba7f88934bfc987b78342932a53ee20c","kind":"rule","proven":true,"doc":"Unsigned division by a power of two is a shift.","examples":[["udiv(p, 16)","p >>u 4"]],"source":"rule udiv_pow2<W>(x: W, c: const W) { udiv(x, c) => x >>u k if is_pow2(c) let k: W = ctz(c) }","ledger":"rule exhaustive(inst=6,maxw=6,cases=5460,fired=642) sampled(inst=22,cases=1408,fired=920)"}
