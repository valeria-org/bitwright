bitwright 1;

// Identities for the equality-saturation search service (`bitwright::eqsat`). They are
// unconditional equations in the conservative fragment (`+ - * & | ^ neg ~`, one width), used in
// both directions by the search; the directed engine never runs them. Every identity is checked by
// `bitwright::check` and recorded in `eqsat.bwr.proof`.

group eqsat.assoc {
    #[example("(p + q) + r" => "p + (q + r)")]
    identity add_assoc<W>(x: W, y: W, z: W) { (x + y) + z <=> x + (y + z) }

    #[example("(p * q) * r" => "p * (q * r)")]
    identity mul_assoc<W>(x: W, y: W, z: W) { (x * y) * z <=> x * (y * z) }

    #[example("(p & q) & r" => "p & (q & r)")]
    identity and_assoc<W>(x: W, y: W, z: W) { (x & y) & z <=> x & (y & z) }

    #[example("(p | q) | r" => "p | (q | r)")]
    identity or_assoc<W>(x: W, y: W, z: W) { (x | y) | z <=> x | (y | z) }

    #[example("(p ^ q) ^ r" => "p ^ (q ^ r)")]
    identity xor_assoc<W>(x: W, y: W, z: W) { (x ^ y) ^ z <=> x ^ (y ^ z) }
}

// Distributivity, one group per operator pair: together, `and_or` and `or_and` rewrite each
// other's results without end, so a search that uses both never saturates.
group eqsat.distrib {
    #[example("p * (q + r)" => "p * q + p * r")]
    identity mul_add<W>(x: W, y: W, z: W) { x * (y + z) <=> x * y + x * z }
}

group eqsat.distrib_and {
    #[example("p & (q | r)" => "(p & q) | (p & r)")]
    identity and_or<W>(x: W, y: W, z: W) { x & (y | z) <=> (x & y) | (x & z) }

    #[example("p & (q ^ r)" => "(p & q) ^ (p & r)")]
    identity and_xor<W>(x: W, y: W, z: W) { x & (y ^ z) <=> (x & y) ^ (x & z) }
}

group eqsat.distrib_or {
    #[example("p | (q & r)" => "(p | q) & (p | r)")]
    identity or_and<W>(x: W, y: W, z: W) { x | (y & z) <=> (x | y) & (x | z) }
}

group eqsat.negation {
    #[example("~(p & q)" => "~p | ~q")]
    identity de_morgan_and<W>(x: W, y: W) { ~(x & y) <=> ~x | ~y }

    #[example("~(p | q)" => "~p & ~q")]
    identity de_morgan_or<W>(x: W, y: W) { ~(x | y) <=> ~x & ~y }

    #[example("-(p + q)" => "-p + -q")]
    identity neg_add<W>(x: W, y: W) { -(x + y) <=> -x + -y }

    #[example("-(p * q)" => "-p * q")]
    identity neg_mul<W>(x: W, y: W) { -(x * y) <=> -x * y }

    #[example("~(p ^ q)" => "~p ^ q")]
    identity not_xor<W>(x: W, y: W) { ~(x ^ y) <=> ~x ^ y }
}

// No MBA group: identities such as `x ^ y <=> (x | y) - (x & y)` produce, in both directions,
// terms the others match again, so a search over them never saturates, and publication requires
// saturation. Linear MBA belongs to the `LinearMba` pass and the MBA service.

// Cancellations, used in their authored direction only (a rule's right side may drop variables,
// so it cannot be read backwards). Inside the e-graph nothing canonicalizes, so these do what
// the builder does at construction.
group eqsat.cancel {
    #[example("(p + q) - q" => "p")]
    rule add_sub<W>(x: W, y: W) { (x + y) - y => x }

    #[example("(p - q) + q" => "p")]
    rule sub_add<W>(x: W, y: W) { (x - y) + y => x }

    #[example("(p ^ q) ^ q" => "p")]
    rule xor_xor<W>(x: W, y: W) { (x ^ y) ^ y => x }

    // (Folded by the builder at construction, so no arena example can fire; needed inside
    // the e-graph, where nothing canonicalizes.)
    #[allow(BW0402, BW0407)]
    rule neg_neg<W>(x: W) { -(-x) => x }

    // (Folded by the builder at construction, so no arena example can fire; needed inside
    // the e-graph, where nothing canonicalizes.)
    #[allow(BW0402, BW0407)]
    rule not_not<W>(x: W) { ~(~x) => x }

    #[example("p + -p" => "0")]
    rule add_neg<W>(x: W) { x + -x => 0 }

    // (Folded by the builder at construction, so no arena example can fire; needed inside
    // the e-graph, where nothing canonicalizes.)
    #[allow(BW0402, BW0407)]
    rule mul_one<W>(x: W) { x * 1 => x }

    // (Folded by the builder at construction, so no arena example can fire; needed inside
    // the e-graph, where nothing canonicalizes.)
    #[allow(BW0402, BW0407)]
    rule mul_zero<W>(x: W) { x * 0 => 0 }

    // (Folded by the builder at construction, so no arena example can fire; needed inside
    // the e-graph, where nothing canonicalizes.)
    #[allow(BW0402, BW0407)]
    rule add_zero<W>(x: W) { x + 0 => x }
}

// Extended mixed-width cast, shift, select, and Facts-guarded equations (`Fragment::extended`).
group eqsat.casts {
    #[example("zext<16>(p) & zext<16>(q)" => "zext<16>(p & q)")]
    identity zext_and<W, U>(x: W, y: W) where W < U { zext<U>(x) & zext<U>(y) <=> zext<U>(x & y) }

    #[example("zext<16>(p) | zext<16>(q)" => "zext<16>(p | q)")]
    identity zext_or<W, U>(x: W, y: W) where W < U { zext<U>(x) | zext<U>(y) <=> zext<U>(x | y) }

    #[example("zext<16>(p) ^ zext<16>(q)" => "zext<16>(p ^ q)")]
    identity zext_xor<W, U>(x: W, y: W) where W < U { zext<U>(x) ^ zext<U>(y) <=> zext<U>(x ^ y) }

    #[example("sext<16>(p) & sext<16>(q)" => "sext<16>(p & q)")]
    identity sext_and<W, U>(x: W, y: W) where W < U { sext<U>(x) & sext<U>(y) <=> sext<U>(x & y) }

    #[example("sext<16>(p) | sext<16>(q)" => "sext<16>(p | q)")]
    identity sext_or<W, U>(x: W, y: W) where W < U { sext<U>(x) | sext<U>(y) <=> sext<U>(x | y) }

    #[example("sext<16>(p) ^ sext<16>(q)" => "sext<16>(p ^ q)")]
    identity sext_xor<W, U>(x: W, y: W) where W < U { sext<U>(x) ^ sext<U>(y) <=> sext<U>(x ^ y) }

    #[example("concat(p ^ r, q ^ s)" => "concat(p, q) ^ concat(r, s)")]
    identity concat_xor<W, U>(x: W, y: U, z: W, t: U) {
        concat(x ^ z, y ^ t) <=> concat(x, y) ^ concat(z, t)
    }

    #[example("concat(p & r, q & s)" => "concat(p, q) & concat(r, s)")]
    identity concat_and<W, U>(x: W, y: U, z: W, t: U) {
        concat(x & z, y & t) <=> concat(x, y) & concat(z, t)
    }

    #[example("concat(p | r, q | s)" => "concat(p, q) | concat(r, s)")]
    identity concat_or<W, U>(x: W, y: U, z: W, t: U) {
        concat(x | z, y | t) <=> concat(x, y) | concat(z, t)
    }

    #[allow(BW0402, BW0407)]
    rule trunc_zext<W, U>(x: W) where W < U { extract<0, W>(zext<U>(x)) => x }

    #[allow(BW0402, BW0407)]
    rule trunc_sext<W, U>(x: W) where W < U { extract<0, W>(sext<U>(x)) => x }

    #[allow(BW0402, BW0407)]
    rule lo_concat<W, U>(h: W, l: U) { extract<0, U>(concat(h, l)) => l }

    #[allow(BW0402, BW0407)]
    rule hi_concat<W, U>(h: W, l: U) { extract<U, W>(concat(h, l)) => h }
}

group eqsat.shifts {
    #[example("(p + q) << r" => "(p << r) + (q << r)")]
    identity shl_add<W>(x: W, y: W, s: W) { (x + y) << s <=> (x << s) + (y << s) }

    #[example("(p & q) << r" => "(p << r) & (q << r)")]
    identity shl_and<W>(x: W, y: W, s: W) { (x & y) << s <=> (x << s) & (y << s) }

    #[example("(p | q) << r" => "(p << r) | (q << r)")]
    identity shl_or<W>(x: W, y: W, s: W) { (x | y) << s <=> (x << s) | (y << s) }

    #[example("(p ^ q) << r" => "(p << r) ^ (q << r)")]
    identity shl_xor<W>(x: W, y: W, s: W) { (x ^ y) << s <=> (x << s) ^ (y << s) }

    #[example("(p & q) >>u r" => "(p >>u r) & (q >>u r)")]
    identity lshr_and<W>(x: W, y: W, s: W) { (x & y) >>u s <=> (x >>u s) & (y >>u s) }

    #[example("(p | q) >>u r" => "(p >>u r) | (q >>u r)")]
    identity lshr_or<W>(x: W, y: W, s: W) { (x | y) >>u s <=> (x >>u s) | (y >>u s) }

    #[example("(p ^ q) >>u r" => "(p >>u r) ^ (q >>u r)")]
    identity lshr_xor<W>(x: W, y: W, s: W) { (x ^ y) >>u s <=> (x >>u s) ^ (y >>u s) }

    #[example("rotl(p ^ q, r)" => "rotl(p, r) ^ rotl(q, r)")]
    identity rotl_xor<W>(x: W, y: W, s: W) { rotl(x ^ y, s) <=> rotl(x, s) ^ rotl(y, s) }
}

group eqsat.select {
    #[example("select(c:1, p, q) + r" => "select(c:1, p + r, q + r)")]
    identity select_add<W>(c: 1, x: W, y: W, z: W) {
        select(c, x, y) + z <=> select(c, x + z, y + z)
    }

    #[example("select(c:1, p, q) ^ r" => "select(c:1, p ^ r, q ^ r)")]
    identity select_xor<W>(c: 1, x: W, y: W, z: W) {
        select(c, x, y) ^ z <=> select(c, x ^ z, y ^ z)
    }

    #[example("select(c:1, p, q) & r" => "select(c:1, p & r, q & r)")]
    identity select_and<W>(c: 1, x: W, y: W, z: W) {
        select(c, x, y) & z <=> select(c, x & z, y & z)
    }

    #[allow(BW0402, BW0407)]
    rule select_same<W>(c: 1, x: W) { select(c, x, x) => x }
}

group eqsat.facts {
    #[example("(p & 0xf0) + (q & 0x0f)" => "(p & 0xf0) | (q & 0x0f)")]
    rule add_disjoint<W>(x: W, y: W) { x + y => x | y if disjoint(x, y) }

    #[example("(p & 0xf0) ^ (q & 0x0f)" => "(p & 0xf0) | (q & 0x0f)")]
    rule xor_disjoint<W>(x: W, y: W) { x ^ y => x | y if disjoint(x, y) }

    #[example("(p & 0x0f) & 0x3f" => "p & 0x0f")]
    rule and_redundant<W>(x: W, c: const W) { x & c => x if zero_bits(x, ~c) }

    #[example("(p & 0x0f) & 0xf0" => "0")]
    rule and_disjoint<W>(x: W, y: W) { x & y => 0 if disjoint(x, y) }

    #[example("udiv(p | 1, p | 1)" => "1")]
    rule udiv_self_nonzero<W>(x: W) { udiv(x, x) => 1 if nonzero(x) }
}
